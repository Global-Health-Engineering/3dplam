---
import site from '../data/site.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const pp = site.print_profile;

const settings = [
  { label: 'Layer height', value: `${pp.layer_height_mm} mm`, changed: '—' },
  { label: 'Wall loops', value: pp.wall_loops, changed: 'yes (stock 2)' },
  { label: 'Top shell layers', value: pp.top_shell_layers, changed: 'no — stock default' },
  { label: 'Top shell thickness', value: `${pp.top_shell_thickness_mm} mm`, changed: 'yes' },
  { label: 'Bottom shell layers', value: pp.bottom_shell_layers, changed: 'yes (stock 3)' },
  { label: 'Bottom shell thickness', value: `${pp.bottom_shell_thickness_mm} mm`, changed: 'yes' },
  { label: 'Sparse infill', value: `${pp.infill_pct}% ${pp.infill_pattern}`, changed: 'no' },
  { label: 'Nozzle', value: `${pp.nozzle_mm} mm`, changed: 'no' },
];

const materials = [
  { name: 'ABS', enclosure: 'Yes', note: 'Recommended — best heat and mechanical performance' },
  { name: 'ASA', enclosure: 'Yes', note: 'Equivalent to ABS, less widely available' },
  { name: 'PETG', enclosure: 'No', note: 'Viable below ~80 °C' },
  { name: 'rPET', enclosure: 'No', note: 'Sustainable route — needs the compensated hardware/rpet/ geometry' },
  { name: 'PLA', enclosure: 'No', note: 'Not recommended — 60 °C glass transition, absorbs water' },
];

const slicers = [
  { bambu: 'Wall loops = 6', prusa: 'Perimeters = 6', cura: 'Wall Line Count = 6' },
  { bambu: `Top shell thickness = ${pp.top_shell_thickness_mm} mm (layers stay at ${pp.top_shell_layers})`, prusa: `Top minimum shell thickness = ${pp.top_shell_thickness_mm} mm`, cura: `Top Thickness = ${pp.top_shell_thickness_mm} mm` },
  { bambu: `Bottom shell layers = ${pp.bottom_shell_layers}, thickness = ${pp.bottom_shell_thickness_mm} mm`, prusa: `Bottom solid layers = ${pp.bottom_shell_layers}`, cura: `Bottom Layers = ${pp.bottom_shell_layers}` },
];

const profiles = [
  { label: 'X1 Carbon — ABS', file: '3dplam-x1c-abs.json' },
  { label: 'P2S — ABS', file: '3dplam-p2s-abs.json' },
];
---
<section id="print">
  <div class="eyebrow">Print</div>
  <h2>The print settings are not optional.</h2>
  <p class="lead">
    A manifold sliced at default settings is porous: the syringe pulls air
    through the plastic instead of pulling water through the membrane, and
    filtration fails outright. This is the single most important fact in
    this repository — get this table right before printing anything.
  </p>

  <div class="scroll-x">
    <table class="settings-table">
      <thead>
        <tr><th>Setting</th><th>Value</th><th>Changed from stock?</th></tr>
      </thead>
      <tbody>
        {settings.map((s) => (
          <tr>
            <td>{s.label}</td>
            <td class="value">{s.value}</td>
            <td>{s.changed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Everything else can stay at your slicer's defaults for the material.
    Full rationale, both Bambu Studio process profiles, and printer notes:
    <a href={`${site.repo}/blob/main/hardware/print-profiles/README.md`}>hardware/print-profiles/README.md</a>.
  </p>

  <h3>Any slicer</h3>
  <p>
    The requirement is geometric, not vendor-specific: at least
    {pp.wall_loops} perimeter loops, and a top/bottom shell of at least
    ~{pp.top_shell_thickness_mm} mm.
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Bambu Studio</th><th>PrusaSlicer / OrcaSlicer</th><th>Cura</th></tr>
      </thead>
      <tbody>
        {slicers.map((s) => (
          <tr><td>{s.bambu}</td><td>{s.prusa}</td><td>{s.cura}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Materials</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Material</th><th>Enclosure needed</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {materials.map((m) => (
          <tr><td>{m.name}</td><td>{m.enclosure}</td><td>{m.note}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Full heat, UV, outdoor-weathering and sterilisation results per material
    are in <a href="#performance">Performance</a> and
    <a href={`${site.repo}/blob/main/docs/printing.md`}>docs/printing.md</a>.
  </p>

  <h3>Profiles</h3>
  <p>
    Importable Bambu Studio process profiles for the printers used to
    validate this design:
  </p>
  <ul class="profile-list">
    {profiles.map((p) => (
      <li>
        <a href={`${site.repo}/blob/main/hardware/print-profiles/${p.file}`}>
          {p.label} <code>{p.file}</code>
        </a>
      </li>
    ))}
  </ul>

  <h3>Watch it print</h3>
  <p>
    A timelapse of the base printing, on the profile above, no supports.
  </p>
  <video
    class="timelapse"
    src={`${base}/video/base-printing-timelapse.mp4`}
    muted
    loop
    playsinline
    preload="metadata"
    controls
    width="1168"
    height="720"
  >
    Your browser does not support embedded video. The file is in
    <code>site/public/video/</code>.
  </video>
</section>

<style>
  #print h2 { max-width: 20ch; }
  #print h3 {
    font-size: 20px;
    margin: 44px 0 12px;
  }
  .settings-table .value {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent);
  }
  .settings-table {
    background: var(--bg-2);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .settings-table th, .settings-table td { padding: 12px 16px; }
  .table-note {
    font-size: 13.5px;
    margin-top: 14px;
  }
  code {
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: .92em;
    overflow-wrap: break-word;
  }
  .settings-table code { background: transparent; padding: 0; }

  .profile-list {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    gap: 10px;
  }
  .profile-list li {
    padding: 12px 16px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .timelapse {
    display: block;
    width: 100%;
    max-width: 560px;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #000;
    margin-top: 8px;
  }
</style>
