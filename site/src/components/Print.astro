---
import site from '../data/site.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const pp = site.print_profile;

const settings = [
  { label: 'Layer height', value: `${pp.layer_height_mm} mm`, changed: 'no' },
  { label: 'Sparse infill', value: `${pp.infill_pct}% ${pp.infill_pattern}`, changed: 'no' },
  { label: 'Wall loops', value: pp.wall_loops, changed: 'yes (stock 2)' },
  { label: 'Top shell layers', value: pp.top_shell_layers, changed: 'yes (stock 5)' },
  { label: 'Bottom shell layers', value: pp.bottom_shell_layers, changed: 'yes (stock 3)' },
  { label: 'Nozzle', value: `${pp.nozzle_mm} mm`, changed: 'no' },
];

const materials = [
  { name: 'ABS', enclosure: 'Yes', note: 'Recommended — best heat and mechanical performance' },
  { name: 'ASA', enclosure: 'Yes', note: 'Equivalent to ABS, less widely available' },
  { name: 'PETG', enclosure: 'No', note: 'Viable below ~80 °C' },
  { name: 'rPET', enclosure: 'No', note: 'Sustainable route — needs the compensated hardware/rpet/ geometry' },
  { name: 'PLA', enclosure: 'No', note: 'Not recommended — 60 °C glass transition, absorbs water' },
];

const slicers = [
  { bambu: `Wall loops = ${pp.wall_loops}`, prusa: `Perimeters = ${pp.wall_loops}`, cura: `Wall Line Count = ${pp.wall_loops}` },
  { bambu: `Top shell layers = ${pp.top_shell_layers}`, prusa: `Top solid layers = ${pp.top_shell_layers}`, cura: `Top Layers = ${pp.top_shell_layers}` },
  { bambu: `Bottom shell layers = ${pp.bottom_shell_layers}`, prusa: `Bottom solid layers = ${pp.bottom_shell_layers}`, cura: `Bottom Layers = ${pp.bottom_shell_layers}` },
];

const profiles = [
  { label: 'X1 Carbon — ABS', file: '3dplam-x1c-abs.json' },
  { label: 'P2S — ABS', file: '3dplam-p2s-abs.json' },
];
---
<section id="print">
  <div class="eyebrow">Print settings</div>
  <h2>Print settings</h2>
  <p class="lead">
    Below {pp.wall_loops} wall loops the printed wall is porous: the
    syringe draws air through the material instead of water through the
    membrane, and filtration fails. The table below lists every setting
    that must be changed from a slicer's stock defaults.
  </p>

  <div class="scroll-x">
    <table class="settings-table">
      <thead>
        <tr><th>Setting</th><th>Value</th><th>Changed from stock?</th></tr>
      </thead>
      <tbody>
        {settings.map((s) => (
          <tr>
            <td>{s.label}</td>
            <td class="value">{s.value}</td>
            <td>{s.changed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Everything else can stay at your slicer's defaults for the material.
    Full rationale, both Bambu Studio process profiles, and printer notes:
    <a href={`${site.repo}/blob/main/hardware/print-profiles/README.md`}>hardware/print-profiles/README.md</a>.
  </p>

  <h3>Any slicer</h3>
  <p>
    The requirement is geometric, not vendor-specific: at least
    {pp.wall_loops} perimeter loops, and top and bottom shells of at least
    {pp.top_shell_layers} solid layers each.
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Bambu Studio</th><th>PrusaSlicer / OrcaSlicer</th><th>Cura</th></tr>
      </thead>
      <tbody>
        {slicers.map((s) => (
          <tr><td>{s.bambu}</td><td>{s.prusa}</td><td>{s.cura}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Materials</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Material</th><th>Enclosure needed</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {materials.map((m) => (
          <tr><td>{m.name}</td><td>{m.enclosure}</td><td>{m.note}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Full heat, UV, outdoor-weathering and sterilisation results per material
    are in <a href="#validation">Validation</a> and
    <a href={`${site.repo}/blob/main/docs/printing.md`}>docs/printing.md</a>.
  </p>

  <h3>Profiles</h3>
  <p>
    Bambu Studio process profiles for the printers used to validate this
    design, importable directly:
  </p>
  <ul class="profile-list">
    {profiles.map((p) => (
      <li>
        <a href={`${site.repo}/blob/main/hardware/print-profiles/${p.file}`}>
          {p.label} <code>{p.file}</code>
        </a>
      </li>
    ))}
  </ul>

  <h3>Print timelapse</h3>
  <p>
    The clip below shows the base printing on the profile above, without
    support structures.
  </p>
  <!-- Author-supplied GIF (720x720, 86 frames, 8.6 s, 10 fps); loops on its own with no interaction needed. -->
  <img
    class="timelapse"
    src={`${base}/video/base-printing-timelapse.gif`}
    alt="Timelapse of the base printing on the profile above: repeating loop, no support structures, printed in ABS."
    width="720"
    height="720"
    loading="lazy"
  />
</section>

<style>
  #print h3 {
    margin: 32px 0 10px;
  }
  .settings-table .value {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent);
  }
  .settings-table {
    background: var(--bg-2);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .settings-table th, .settings-table td { padding: 12px 16px; }
  .table-note {
    font-size: 13.5px;
    margin-top: 14px;
  }
  code {
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: .92em;
    overflow-wrap: break-word;
  }
  .settings-table code { background: transparent; padding: 0; }

  .profile-list {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    gap: 10px;
  }
  .profile-list li {
    padding: 12px 16px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .timelapse {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-top: 8px;
  }
</style>
