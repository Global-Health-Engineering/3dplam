---
import site from '../data/site.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
const pp = site.print_profile;

const settings = [
  { label: 'Layer height', value: `${pp.layer_height_mm.toFixed(2)} mm`, changed: 'no' },
  { label: 'Sparse infill', value: `${pp.infill_pct} % ${pp.infill_pattern}`, changed: 'no' },
  { label: 'Wall loops', value: pp.wall_loops, changed: 'yes (stock 2)' },
  { label: 'Top shell layers', value: pp.top_shell_layers, changed: 'yes (stock 5)' },
  { label: 'Bottom shell layers', value: pp.bottom_shell_layers, changed: 'yes (stock 3)' },
  { label: 'Nozzle', value: `${pp.nozzle_mm} mm`, changed: 'no' },
];

const materials = [
  { name: 'ABS', enclosure: 'Yes', note: 'Recommended, with the best heat and mechanical performance' },
  { name: 'ASA', enclosure: 'Yes', note: 'Equivalent to ABS, less widely available' },
  { name: 'PETG', enclosure: 'No', note: 'Viable below ~80 °C' },
  { name: 'rPET', enclosure: 'No', note: 'Sustainable option that needs the compensated hardware/rpet/ geometry' },
  { name: 'PLA', enclosure: 'No', note: 'Not recommended, because of its 60 °C glass transition and water absorption' },
];

const slicers = [
  { bambu: `Wall loops = ${pp.wall_loops}`, prusa: `Perimeters = ${pp.wall_loops}`, cura: `Wall Line Count = ${pp.wall_loops}` },
  { bambu: `Top shell layers = ${pp.top_shell_layers}`, prusa: `Top solid layers = ${pp.top_shell_layers}`, cura: `Top Layers = ${pp.top_shell_layers}` },
  { bambu: `Bottom shell layers = ${pp.bottom_shell_layers}`, prusa: `Bottom solid layers = ${pp.bottom_shell_layers}`, cura: `Bottom Layers = ${pp.bottom_shell_layers}` },
];

const profiles = [
  { label: 'X1 Carbon, ABS', file: '3dplam-x1c-abs.json' },
  { label: 'P2S, ABS', file: '3dplam-p2s-abs.json' },
];
---
<section id="print">
  <div class="eyebrow">Print settings</div>
  <h2>Print settings</h2>
  <p class="lead">
    At least {pp.wall_loops} wall loops are needed to keep the printed
    wall from being porous. With fewer loops, the syringe draws air
    through the material instead of water through the membrane, and
    filtration fails. The table below lists the settings of the validated
    prints and marks the ones that differ from a slicer's stock defaults.
  </p>

  <div class="scroll-x">
    <table class="settings-table">
      <thead>
        <tr><th>Setting</th><th>Value</th><th>Changed from stock?</th></tr>
      </thead>
      <tbody>
        {settings.map((s) => (
          <tr>
            <td>{s.label}</td>
            <td class="value">{s.value}</td>
            <td>{s.changed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Every other setting can stay at your slicer's defaults for the material.
    <a href={`${site.repo}/blob/main/hardware/print-profiles/README.md`}>hardware/print-profiles/README.md</a>
    gives the full rationale, both Bambu Studio process profiles and printer notes.
  </p>

  <h3>Any slicer</h3>
  <p>
    The requirement is geometric, so it applies in every slicer. Use at
    least {pp.wall_loops} perimeter loops, and top and bottom shells of at
    least {pp.top_shell_layers} solid layers each.
  </p>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Bambu Studio</th><th>PrusaSlicer / OrcaSlicer</th><th>Cura</th></tr>
      </thead>
      <tbody>
        {slicers.map((s) => (
          <tr><td>{s.bambu}</td><td>{s.prusa}</td><td>{s.cura}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Materials</h3>
  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Material</th><th>Enclosure needed</th><th>Notes</th></tr>
      </thead>
      <tbody>
        {materials.map((m) => (
          <tr><td>{m.name}</td><td>{m.enclosure}</td><td>{m.note}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Full heat, UV, outdoor-weathering and sterilisation results per material
    are in <a href="#validation">Validation</a> and
    <a href={`${site.repo}/blob/main/docs/printing.md`}>docs/printing.md</a>.
  </p>

  <h3>Profiles</h3>
  <p>
    These Bambu Studio process profiles can be imported directly. The
    validated parts were printed on the X1 Carbon; the P2S profile has the
    same settings but was used only for tolerance test prints.
  </p>
  <ul class="profile-list">
    {profiles.map((p) => (
      <li>
        <a href={`${site.repo}/blob/main/hardware/print-profiles/${p.file}`}>
          {p.label} <code>{p.file}</code>
        </a>
      </li>
    ))}
  </ul>

  <h3>Print timelapse</h3>
  <p>
    The clip below shows the final base (V1.3) printing in rPET, without
    support structures.
  </p>
  <!-- Author-supplied GIF (800x493, 115 frames, 11.5 s, 10 fps); loops on its own with no interaction needed. -->
  <img
    class="timelapse"
    src={`${base}/video/base-printing-timelapse.gif`}
    alt="Timelapse of the final base (V1.3) printing in dark blue rPET without support structures, shown as a repeating loop."
    width="800"
    height="493"
    loading="lazy"
  />
</section>

<style>
  #print h3 {
    margin: 32px 0 10px;
  }
  .settings-table .value {
    font-family: var(--mono);
    font-weight: 600;
    color: var(--accent);
  }
  .settings-table {
    background: var(--bg-2);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .settings-table th, .settings-table td { padding: 12px 16px; }
  .table-note {
    font-size: 13.5px;
    margin-top: 14px;
  }
  code {
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: .92em;
    overflow-wrap: break-word;
  }
  .settings-table code { background: transparent; padding: 0; }

  .profile-list {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    display: grid;
    gap: 10px;
  }
  .profile-list li {
    padding: 12px 16px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .timelapse {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    margin-top: 8px;
  }
</style>
