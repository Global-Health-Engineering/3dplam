---
import site from '../data/site.json';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const parts = [
  { name: 'Base', file: 'base.stl', envelope: '77.0 × 77.0 × 38.7 mm', volume: '39.7 cm³ solid' },
  { name: 'Funnel', file: 'funnel.stl', envelope: '71.8 × 71.8 × 55.5 mm', volume: '16.0 cm³ solid' },
  { name: 'Filter support', file: 'filter-support-strand-mesh.stl', envelope: '37.3 × 37.3 × 2.9 mm', volume: '1.4 cm³ solid' },
];

// Two pairs, each a two-up grid at the page's single content width. Row 1
// is the assembly renders; row 2 is the filter-support render next to the
// close-up photograph of the same part. assembly-section.png has been
// dropped from the design; do not re-add a reference to it.
//
// `model` opts a tile into the click-to-open 3D viewer, and is the name of
// a .glb written by tools/render_parts.py from the very same Blender scene
// as the tile's poster image. The fourth tile has no model on purpose: it
// is a photograph of the part as actually printed, which is evidence no
// render can stand in for; a 3D model of it would show the CAD, not the
// in-air strands that came off the machine.
const renders = [
  { dir: 'renders', src: 'assembly-exploded.png', model: 'assembly-exploded.glb', alt: 'The three printed parts separated in an exploded view, showing the correct stacking order: base, filter support, funnel.', caption: 'Exploded view: base, filter support, funnel, in stacking order.' },
  { dir: 'renders', src: 'membrane-clamp.png', model: 'membrane-clamp.glb', alt: 'Close-up section of the sealing interface, where the membrane is clamped between the base’s raised edge and the funnel’s inner slope.', caption: 'The seal: membrane clamped between the base’s raised edge and the funnel’s slope.' },
  { dir: 'renders', src: 'filter-support-section.png', model: 'filter-support-section.glb', alt: 'A section cut through the filter support, showing the individual printed strands of the strand-mesh design.', caption: 'Cut through the strand mesh: parallel in-air strands, each layer rotated 120°.' },
  { dir: 'photos', src: 'filter-support-strand-mesh.webp', alt: 'Close-up photograph of the printed filter support, individual in-air printed strands visible.', caption: 'The strand-mesh filter support as printed: the default, and the one used for the <em>E. coli</em> validation.' },
];
---
<section id="device">
  <div class="eyebrow">Device</div>
  <h2>Device</h2>
  <p class="lead">
    The manifold is built from three printed parts (a base, a funnel and a filter
    support), each printed separately without support structures. They
    lock together without adhesive except at the syringe joint. A 100 mL
    PVC syringe and a 0.45 µm membrane filter complete the assembly.
  </p>

  <figure class="device-photo">
    <img
      src={`${base}/photos/manifold-assembled.webp`}
      alt="The assembled 3DPLAM manifold printed in dark blue rPET, three-quarter view."
      loading="lazy"
    />
    <figcaption>The assembled manifold, printed in rPET.</figcaption>
  </figure>

  <div class="scroll-x">
    <table>
      <thead>
        <tr><th>Part</th><th>File</th><th>Envelope</th><th>Volume</th></tr>
      </thead>
      <tbody>
        {parts.map((p) => (
          <tr>
            <td>{p.name}</td>
            <td><code>stl/{p.file}</code></td>
            <td>{p.envelope}</td>
            <td>{p.volume}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="table-note">
    Dimensions and files for the default configuration: strand-mesh filter
    support, clamped-membrane funnel. See <a href={`${site.repo}/blob/main/hardware/README.md`}>hardware/README.md</a>
    for the concurrent alternatives: <code>filter-support-hex-hole.stl</code>
    (more forgiving to print, but filters less uniformly) and <code>funnel-tape-fit.stl</code> (for a
    tape-sealed base joint).
  </p>

  <div class="cad-note">
    <h3>Edit the design yourself</h3>
    <p>
      The source CAD is public in Onshape. If you want to edit it,
      <em>Make a copy</em> first, so you can change dimensions,
      tolerances, or the fit for your printer or membrane.
      An Onshape account is free.
    </p>
    <a class="cad-link" href={site.onshape} rel="noopener">Open the source CAD in Onshape</a>
    <p class="cad-sub">
      Editable STEP for every part also ships in the repository, under
      <a href={`${site.repo}/tree/main/hardware/step`}>hardware/step/</a>.
      If exporting from Onshape, set units to millimetres (see
      <a href={`${site.repo}/blob/main/hardware/onshape.md`}>hardware/onshape.md</a>).
    </p>
  </div>

  <div class="render-grid">
    {renders.map((r) => (
      <figure class="render">
        {r.model ? (
          <button
            type="button"
            class="render-open"
            data-model={`${base}/models/${r.model}`}
            data-caption={r.caption}
          >
            <img src={`${base}/${r.dir}/${r.src}`} alt={r.alt} loading="lazy" />
            <span class="render-cue" aria-hidden="true">View in 3D</span>
            <span class="visually-hidden">Open an interactive 3D model of this view</span>
          </button>
        ) : (
          <img src={`${base}/${r.dir}/${r.src}`} alt={r.alt} loading="lazy" />
        )}
        <figcaption set:html={r.caption} />
      </figure>
    ))}
  </div>

  <!--
    A native <dialog>, not a hand-rolled overlay: showModal() gives the
    focus trap, the Esc-to-close binding, the inert background and the
    ::backdrop for free, all of which a div would have to reimplement and
    usually reimplements incorrectly.
  -->
  <dialog id="model-dialog" aria-label="Interactive 3D model">
    <div class="model-head">
      <p class="model-caption" id="model-caption"></p>
      <div class="model-actions">
        <button type="button" id="model-reset" class="model-btn">Reset view</button>
        <button type="button" id="model-close" class="model-btn" aria-label="Close 3D model">Close</button>
      </div>
    </div>
    <div class="model-stage" id="model-stage">
      <p class="model-status" id="model-status">Loading model…</p>
    </div>
    <!-- Two wordings, one shown by media query: "scroll to zoom" is wrong
         advice on a touch device, where the gesture is a pinch. -->
    <p class="model-hint">
      <span class="hint-pointer">Drag to rotate · scroll to zoom · right-drag or shift-drag to pan</span>
      <span class="hint-touch">Drag to rotate · pinch to zoom · two-finger drag to pan</span>
    </p>
  </dialog>
</section>

<script>
  // Progressive enhancement, in the strict sense: the posters are plain
  // <img> inside a <button>, so with this script dead the section still
  // shows every render, only the extra 3D affordance is missing. Hence
  // the early returns rather than any fallback path.
  const dialog = document.getElementById('model-dialog') as HTMLDialogElement | null;
  const stage = document.getElementById('model-stage');
  const status = document.getElementById('model-status');
  const caption = document.getElementById('model-caption');
  const openers = document.querySelectorAll<HTMLButtonElement>('.render-open');

  if (dialog && stage && status && caption && openers.length && dialog.showModal) {
    let viewer: any = null;
    let opener: HTMLButtonElement | null = null;

    async function open(button: HTMLButtonElement) {
      opener = button;
      caption!.innerHTML = button.dataset.caption ?? '';
      status!.hidden = false;
      status!.textContent = 'Loading model…';
      dialog!.showModal();

      try {
        if (!viewer) {
          // Dynamic import: three.js is fetched here, on the first open,
          // and never as part of the page's initial payload.
          const { createViewer } = await import('../scripts/model-viewer.js');
          viewer = createViewer(stage!);
        }
        await viewer.load(button.dataset.model!);
        viewer.start();
        status!.hidden = true;
      } catch (err) {
        // A WebGL-less browser or a failed fetch must not leave a blank
        // box with no explanation; the poster image is still visible
        // behind the dialog, so say what happened and let them close it.
        console.error(err);
        status!.hidden = false;
        status!.textContent =
          'This browser could not display the 3D model. The rendered image above shows the same view.';
      }
    }

    function close() {
      if (viewer) viewer.stop();
      dialog!.close();
    }

    openers.forEach((button) => button.addEventListener('click', () => open(button)));
    document.getElementById('model-close')?.addEventListener('click', close);
    document.getElementById('model-reset')?.addEventListener('click', () => viewer?.reset());

    // Covers Esc, which fires `close` on the dialog without going through
    // the button above; the render loop has to stop either way.
    dialog.addEventListener('close', () => {
      viewer?.stop();
      opener?.focus();
    });

    // Clicking the backdrop closes. The dialog's own box is the only
    // element whose bounds we can test against here, because the backdrop
    // is a pseudo-element and is not itself an event target.
    //
    // The press has to be checked as well as the release. A `click` fires
    // wherever the pointer is *released*, so testing that alone closed
    // the viewer whenever an orbit drag was released past the dialog
    // edge, easy to do, since rotating means dragging a long way. Only a
    // gesture that both starts and ends outside counts as a backdrop
    // click.
    let pressedOutside = false;
    const isOutside = (event) => {
      const box = dialog.getBoundingClientRect();
      return (
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom
      );
    };
    dialog.addEventListener('pointerdown', (event) => {
      pressedOutside = isOutside(event);
    });
    dialog.addEventListener('click', (event) => {
      if (pressedOutside && isOutside(event)) close();
      pressedOutside = false;
    });

    window.addEventListener('resize', () => {
      if (dialog.open) viewer?.resize();
    });
  }
</script>

<style>
  .device-photo {
    margin: 24px 0;
  }
  .device-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .device-photo figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--fg-dim);
  }
  .table-note {
    font-size: 13.5px;
    margin-top: 14px;
  }
  code {
    background: var(--bg-2);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: .92em;
    overflow-wrap: break-word;
  }

  .cad-note {
    margin: 28px 0 4px;
    padding: 20px 24px;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .cad-note h3 { margin: 0 0 8px; }
  .cad-note p { margin: 0 0 14px; }
  .cad-link {
    display: inline-block;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--ghe-white);
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .cad-link:hover { background: var(--fg); }
  .cad-sub {
    margin: 14px 0 0 !important;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .render-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 32px;
  }
  .render {
    margin: 0;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px;
  }
  .render img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .render figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--fg-dim);
    line-height: 1.45;
  }

  /* The poster is wrapped in a real <button>, not a div with a click
     handler, so it is focusable, announced as a control, and activated by
     Enter/Space with no extra code. These rules only strip the browser's
     default button chrome back to the bare image. */
  .render-open {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 4px;
  }
  .render-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .render-cue {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--ghe-white);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .02em;
    opacity: .82;
  }
  .render-open:hover .render-cue,
  .render-open:focus-visible .render-cue {
    opacity: 1;
    background: var(--accent);
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  #model-dialog {
    width: min(92vw, 900px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
  }
  #model-dialog::backdrop {
    background: rgba(16, 19, 23, .55);
  }
  .model-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .model-caption {
    margin: 0;
    font-size: 13.5px;
    color: var(--fg-dim);
  }
  .model-actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  .model-btn {
    border: 1px solid var(--line);
    background: var(--bg-2);
    color: var(--fg);
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 13px;
    cursor: pointer;
  }
  .model-btn:hover { border-color: var(--accent); color: var(--accent); }

  /* Height is viewport-relative and capped: the model needs real estate
     to be worth orbiting, but the caption and controls must stay on
     screen on a short laptop window. */
  .model-stage {
    position: relative;
    height: min(62vh, 560px);
    background: var(--bg-2);
    /* Without this, an orbit drag across the canvas selects the status
       paragraph underneath it and leaves it highlighted. */
    user-select: none;
  }
  /* three.js writes explicit CSS pixel sizes onto the canvas; these rules
     are the backstop that keeps it inside the stage no matter what it
     writes, so a HiDPI display can never again lay the canvas out at
     devicePixelRatio times the container and show only a corner of it. */
  .model-stage canvas {
    display: block;
    width: 100% !important;
    height: 100% !important;
  }
  .model-status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 24px;
    text-align: center;
    font-size: 13.5px;
    color: var(--fg-dim);
  }
  /* `display: flex` above outranks the UA stylesheet's `[hidden] {
     display: none }`, so setting .hidden in JS would leave this text
     sitting on top of the loaded model. This rule is what actually
     hides it. */
  .model-status[hidden] { display: none; }
  .model-hint {
    margin: 0;
    padding: 10px 16px;
    font-size: 12.5px;
    color: var(--fg-dim);
    border-top: 1px solid var(--line);
  }
  .hint-touch { display: none; }
  /* `hover: none` is the touch signal, not a width breakpoint: a narrow
     desktop window still has a wheel, and a large tablet still pinches. */
  @media (hover: none) {
    .hint-pointer { display: none; }
    .hint-touch { display: inline; }
  }

  @media (max-width: 700px) {
    .render-grid { grid-template-columns: 1fr; }
  }
</style>
